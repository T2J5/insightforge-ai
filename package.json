{
  "name": "insightforge",
  "version": "0.1.0",
  "description": "Enterprise research and report generation agent",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.5.0 <27",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @insightforge/web --filter @insightforge/worker dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
