{
  "name": "@insightforge/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "checkpoint:setup": "tsx src/setup-agent-checkpoints.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --root ../.. --project @insightforge/worker",
    "test:watch": "vitest --root ../.. --project @insightforge/worker",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p ../../tsconfig.base.json"
  },
  "dependencies": {
    "@insightforge/agent": "workspace:*",
    "@insightforge/db": "workspace:*",
    "@insightforge/domain": "workspace:*",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "bullmq": "5.81.2",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "^4.23.12",
    "vitest": "4.1.10"
  }
}
