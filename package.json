{
  "name": "insightforge",
  "version": "0.1.0",
  "description": "Enterprise research and report generation agent",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.5.0 <27",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @insightforge/web --filter @insightforge/worker dev",
    "eval:fixtures": "pnpm --filter @insightforge/evals eval:fixtures",
    "eval:online": "pnpm --filter @insightforge/evals eval:online",
    "e2e": "playwright test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml,css,scss}": [
      "prettier --write"
    ]
  }
}
