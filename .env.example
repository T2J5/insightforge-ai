DATABASE_URL=postgresql://insightforge:insightforge@localhost:5432/insightforge
DATABASE_TEST_URL=postgresql://insightforge:insightforge@localhost:5432/insightforge_test
REDIS_URL=redis://localhost:6379
REDIS_TEST_URL=redis://localhost:6379/1

# 真实模型配置
MODEL_API_KEY=
MODEL_NAME=gpt-5.6-luna

# 使用官方 OpenAI 时保持为空
MODEL_BASE_URL=

# 单次模型请求超时时间
MODEL_TIMEOUT_MS=120000

# AI SDK 自动重试次数
MODEL_MAX_RETRIES=2

# 单次最大输出 Token
MODEL_MAX_OUTPUT_TOKENS=8000

# 每 100 万 Token 的人民币成本
# 不配置时 Agent 的 estimatedCostCny 会记录为 0
MODEL_INPUT_COST_CNY_PER_1M_TOKENS=
MODEL_OUTPUT_COST_CNY_PER_1M_TOKENS=

SEARCH_API_KEY=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=insightforge

OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 至少32个字符，只能保存在服务端
AUTH_SECRET=replace-with-at-least-32-random-characters

# 单次搜索或正文提取请求超时
SEARCH_TIMEOUT_MS=30000

# quick 调研预算
AGENT_QUICK_MAX_SEARCHES=12
AGENT_QUICK_MAX_TOKENS=80000
AGENT_QUICK_MAX_COST_CNY=5
AGENT_QUICK_MAX_DURATION_MS=300000

# deep 调研预算
AGENT_DEEP_MAX_SEARCHES=30
AGENT_DEEP_MAX_TOKENS=200000
AGENT_DEEP_MAX_COST_CNY=15
AGENT_DEEP_MAX_DURATION_MS=900000