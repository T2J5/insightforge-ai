{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "package.json",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @insightforge/worker checkpoint:setup"],
    "startCommand": "pnpm --filter @insightforge/worker start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
